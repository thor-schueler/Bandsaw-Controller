{
    "port": "COM3",
    "board": "esp32:esp32:esp32",
    "prebuild": "python3.exe ./increment_version.py",
    "postbuild": " ",
    "output": "./build",
    "buildPreferences": [
        [
            "compiler.cpp.extra_flags",
            "-DARDUINO_LOOP_STACK_SIZE=3052 -DARDUINOJSON_USE_PSRAM=1 -MMD -c -fno-exceptions"
        ],
        [
            "upload.maximum_size",
            "4194304"
        ],
        [
            "build.partitions",
            "partitions"
        ]
    ],
    "sketch": "Bandsaw Controller.ino",
    "configuration": "JTAGAdapter=default,PSRAM=enabled,PartitionScheme=default,CPUFreq=240,FlashMode=qio,FlashFreq=80,FlashSize=4M,UploadSpeed=921600,LoopCore=1,EventsCore=1,DebugLevel=error,EraseFlash=none,ZigbeeMode=default",
    "programmer": "esptool"
}